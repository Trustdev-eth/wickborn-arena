# Adapter secrets. Never commit real values.
# Shared mint/program/HMAC can also come from the repo `.env` / `.env.local`.
# Public api.devnet.solana.com is rate-limited. Use a dedicated RPC if the adapter logs 429s.
SOLANA_RPC_URL=https://api.devnet.solana.com
GAME_PROGRAM_ID=F9rRZiYeunm6ospKJUyD2kZ6NbBfLJKPxZyPUyDtPW8x
GAME_TOKEN_MINT=
GAME_TOKEN_DECIMALS=9
GAME_TOKEN_CHAIN=solana:devnet
CONTRACT_ADAPTER_KEY=
# Sites origin used to POST /api/contract-receipt after a user transaction finalizes.
SITE_ORIGIN=http://127.0.0.1:5173
STAKE_LOCK_SECONDS=604800
PORT=8788
COMPUTE_UNIT_PRICE_MICROLAMPORTS=1000
# JSON array of the 64-byte settlement/authority secret, or a filesystem path to a Solana keypair.
SETTLEMENT_KEYPAIR_PATH=
SETTLEMENT_KEYPAIR_JSON=
AUTHORITY_KEYPAIR_PATH=
SETTLEMENT_AUTHORITY=
